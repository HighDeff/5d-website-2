# PayPal Configuration
# To enable real PayPal payments, add your PayPal client ID:
# VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# For development, leave blank to use demo mode
# For production, set your real PayPal client ID

# Example:
# VITE_PAYPAL_CLIENT_ID=AYourRealPayPalClientIdHere123456789

# OpenAI Configuration
# To enable AI Image Recognition, add your OpenAI API key:
# VITE_OPENAI_API_KEY=your_openai_api_key_here

# Get your API key from: https://platform.openai.com/api-keys
# Required for AI-powered image analysis and product recognition

# Example:
# VITE_OPENAI_API_KEY=sk-proj-abc123def456ghi789...
